# .streamlit/secrets.toml.example
# Rename this file to 'secrets.toml' or create '.streamlit/secrets.toml'
# Replace the placeholder with your actual 44-character API token from https://quantum.cloud.ibm.com/

IBM_QUANTUM_API_KEY = "YOUR_API_KEY_HERE"

# Optional: If your account uses a specific instance or CRN (e.g. from an invited hub/group/project)
# IBM_QUANTUM_INSTANCE = "crn:v1:bluemix:public:quantum-computing:us-east:a/...::"
